# Copy to .env.local for development, and add the same names in
# Vercel → Project → Settings → Environment Variables.

# --- Required: Supabase (Project Settings → API) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_…) or the legacy "anon" key. Safe in the
# browser: Row Level Security decides what it can do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Local only: never add these to Vercel or expose them to the browser ------
# Used by `npm run db:migrate` (Connect → Session pooler connection string).
SUPABASE_DB_URL=
# Used only by the multi-user end-to-end tests to create throwaway accounts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---------------------------------------------------------------
# Public address, for share previews. Vercel's production URL is used if unset.
NEXT_PUBLIC_SITE_URL=
# Show "Continue with Google" (enable the Google provider in Supabase first).
NEXT_PUBLIC_AUTH_GOOGLE=false
# Enables the PinDrop helper chatbot (server-side only).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Map tiles and routing. Defaults are OpenStreetMap's community servers, which
# are fine for light use; point these at a paid or self-hosted provider for
# heavier traffic.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# NEXT_PUBLIC_ROUTING_WALKING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot
# NEXT_PUBLIC_ROUTING_CYCLING_URL=https://routing.openstreetmap.de/routed-bike/route/v1/bike
# NEXT_PUBLIC_ROUTING_DRIVING_URL=https://router.project-osrm.org/route/v1/driving
